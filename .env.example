# Copy this file to .env and adjust the values. Never commit .env.

# Safety: when true, no real infrastructure is created or destroyed.
CLOUDFORGE_DRY_RUN=true

# Optional API key. When set, mutating requests must send an X-API-Key header.
CLOUDFORGE_API_KEY=

# Upper bound on tracked resources to prevent runaway provisioning.
CLOUDFORGE_MAX_RESOURCES=10

# Terraform execution settings (only used when CLOUDFORGE_DRY_RUN=false).
CLOUDFORGE_TERRAFORM_BINARY=terraform
CLOUDFORGE_TERRAFORM_TIMEOUT_SECONDS=300

# Where per-resource Terraform working directories are created.
CLOUDFORGE_WORKDIR=.cloudforge/workdirs
